{
  "name": "@fh/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed.ts",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 test/*.test.ts",
    "pretest": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.2.1",
    "@trpc/server": "^11.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "rrule": "^2.8.1",
    "superjson": "^2.2.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
