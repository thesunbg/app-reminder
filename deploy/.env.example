# Cổng web container bind vào 127.0.0.1 trên 202.92.6.143, nginx cùng máy
# proxy tới; phải không trùng app khác đang chạy trên 143.
APP_PORT=5599
WEB_ORIGIN=https://reminder.nguyenvando.com
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:thesunbg@gmail.com
# Push native cho app điện thoại (apps/mobile). Dán nguyên một dòng nội dung
# file service account JSON của Firebase, bọc trong nháy đơn.
# Để trống thì kênh native tắt.
FCM_SERVICE_ACCOUNT=
