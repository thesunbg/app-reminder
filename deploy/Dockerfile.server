FROM node:22-alpine AS base
# kernel CentOS 7 (3.10) + Docker 19.03 chặn io_uring → Node 20+ báo EPERM khi ghi file
ENV UV_USE_IO_URING=0
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/server/package.json apps/server/
RUN pnpm install --frozen-lockfile --filter @fh/server

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/server/node_modules ./apps/server/node_modules
COPY . .
WORKDIR /app/apps/server
RUN pnpm exec prisma generate && pnpm exec tsc -p tsconfig.json

FROM base AS runtime
ENV NODE_ENV=production TZ=Asia/Ho_Chi_Minh
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/server /app/apps/server
WORKDIR /app/apps/server
EXPOSE 3001
# migrate trước khi chạy để deploy là một bước duy nhất
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/index.js"]
